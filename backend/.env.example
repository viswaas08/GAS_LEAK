# Copy to .env and fill in for a real deployment. Defaults in config.py are dev-only.
JWT_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/pipeline_gas

SMS_PROVIDER=simulated
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_USE_TLS=true
ACTUATOR_COMMAND_TIMEOUT_SECONDS=20
HEARTBEAT_OFFLINE_AFTER_SECONDS=30
